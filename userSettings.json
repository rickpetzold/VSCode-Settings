{
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "update.mode": "none",
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",
  "http.proxyStrictSSL": false,
  "http.proxyAuthorization": null,
  "http.proxySupport": "off",
  "terminal.integrated.windowsEnableConpty": false,
  "window.newWindowProfile": "Default",
  "editor.scrollBeyondLastLine": false,
  "editor.smoothScrolling": true,
  // formatters
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "editor.formatOnSave": true,
  // vim
  "vim.useSystemClipboard": true,
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.hlsearch": true,
  "vim.leader": "<space>",
  "vim.insertModeKeyBindings": [
    {
      "before": [
        "j",
        "j"
      ],
      "after": [
        "<Esc>"
      ]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    // Navigation - Switch b/w buffers
    {
      "before": [
        "<C-h>"
      ],
      "commands": [
        ":bprevious"
      ]
    },
    {
      "before": [
        "<C-l>"
      ],
      "commands": [
        ":bnext"
      ]
    },
    // Jump paragraphs
    {
      "before": [
        "<C-j>"
      ],
      "after": [
        "}"
      ]
    },
    {
      "before": [
        "<C-k>"
      ],
      "after": [
        "{"
      ]
    },
    // Splits
    {
      "before": [
        "leader",
        "v"
      ],
      "commands": [
        ":vsplit"
      ]
    },
    {
      "before": [
        "leader",
        "h"
      ],
      "commands": [
        ":split"
      ]
    },
    // Panes
    {
      "before": [
        "leader",
        "f",
        "l"
      ],
      "commands": [
        "workbench.action.focusLeftGroup"
      ]
    },
    {
      "before": [
        "leader",
        "f",
        "d"
      ],
      "commands": [
        "workbench.action.focusBelowGroup"
      ]
    },
    {
      "before": [
        "leader",
        "f",
        "u"
      ],
      "commands": [
        "workbench.action.focusAboveGroup"
      ]
    },
    {
      "before": [
        "leader",
        "f",
        "r"
      ],
      "commands": [
        "workbench.action.focusRightGroup"
      ]
    },
    {
      "before": [
        "leader",
        "n",
        "e"
      ],
      "commands": [
        "workbench.explorer.fileView.focus"
      ]
    },
    {
      "before": [
        "leader",
        "f"
      ],
      "commands": [
        "editor.action.formatDocument"
      ]
    },
    // remove unfold with J shortcut
    {
      "before": [
        "J"
      ],
      "after": [
        ""
      ]
    }
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": [
        ">"
      ],
      "commands": [
        "editor.action.indentLines"
      ]
    },
    {
      "before": [
        "<"
      ],
      "commands": [
        "editor.action.outdentLines"
      ]
    },
    {
      "before": [
        "leader",
        "c"
      ],
      "commands": [
        "editor.action.commentLine"
      ]
    }
  ],
  "vim.statusBarColorControl": true,
  "vim.statusBarColors.normal": [
    "#8FBCBB",
    "#000"
  ],
  "vim.statusBarColors.insert": [
    "#BF616A",
    "#000"
  ],
  "vim.statusBarColors.visual": [
    "#B48EAD",
    "#000"
  ],
  "vim.wrapscan": true,
  "workbench.colorCustomizations": {
    "statusBar.background": "#005f87",
    "statusBar.noFolderBackground": "#005f87",
    "statusBar.debuggingBackground": "#005f87",
    "statusBar.foreground": "#ffffff",
    "statusBar.debuggingForeground": "#ffffff"
  },
  "vim.normalModeKeyBindings": [],
  "vim.commandLineModeKeyBindings": [],
  "editor.minimap.enabled": false,
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.profiles.windows": {
    "Git Bash": {
      "source": "Git Bash",
      "args": [
        "--login",
        "-i"
      ]
    }
  },
  "terminal.integrated.allowChords": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "python.analysis.typeCheckingMode": "standard",
  "claudeCode.preferredLocation": "panel",
  "claudeCode.useTerminal": true
}